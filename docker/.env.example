# Epic account
EPIC_EMAIL=
EPIC_PASSWORD=

# LLM request protocol: openai, openai-responses, gemini, or claude
LLM_PROVIDER=openai
LLM_API_KEY=
# Custom OpenAI-format URLs may already contain /v1. The app adds /v1 when
# missing; Gemini adds /v1beta instead.
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=

# Runtime
BROWSER_BACKEND=auto
ENABLE_APSCHEDULER=true
DISABLE_BEZIER_TRAJECTORY=false
EXECUTION_TIMEOUT=120
RESPONSE_TIMEOUT=30
RETRY_ON_FAILURE=true
WAIT_FOR_CHALLENGE_VIEW_TO_RENDER_MS=1500
CONSTRAINT_RESPONSE_SCHEMA=true
