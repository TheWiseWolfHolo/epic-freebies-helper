# Epic account
# If a value contains $, \, #, or ` (e.g. some passwords), wrap it in single
# quotes so python-dotenv keeps it as a literal: EPIC_PASSWORD='abc$def'.
# This only affects local .env files; GitHub Actions Secrets are unaffected.
EPIC_EMAIL=xxxx@qq.com
EPIC_PASSWORD=mypassword

# LLM protocol
# Supported values: openai, openai-responses, gemini, claude
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional for official APIs. Custom OpenAI-compatible URLs may include /v1;
# when the version segment is missing, the app appends /v1 automatically.
# Gemini is normalized to /v1beta instead.
LLM_BASE_URL=https://your-provider.example/v1
# Use a model that supports image input.
LLM_MODEL=
# Optional request-body thinking effort: minimal, low, medium, high
# (Gemini 3.8 Flash minimum supported value is low)
LLM_THINKING_LEVEL=

# Browser runtime
# Supported values: auto, camoufox, playwright
BROWSER_BACKEND=auto
# Optional proxy URL: http://, https://, socks4://, or socks5://
BROWSER_PROXY=

# Optional weekly mobile freebies (claimed via the same $0 desktop web checkout)
# Android is global; iOS is restricted by Epic to EU accounts.
EPIC_MOBILE_ANDROID=false
EPIC_MOBILE_IOS=false

# Local one-shot debugging
ENABLE_APSCHEDULER=false
